# WebSocket URL (optional)
# Use this if your backend is running on a different host/port than the frontend
# VITE_WS_URL=ws://localhost:8080/ws

# API base URL (optional)
# If set, WebSocket will use the same host as the API
# VITE_API_BASE_URL=http://localhost:8080

# Example for development with backend on port 8080:
# VITE_WS_URL=ws://localhost:8080/ws

# Example for production (same host as frontend):
# VITE_WS_URL=/ws