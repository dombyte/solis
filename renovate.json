{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "gomod",
    "dockerfile",
    "docker-compose",
    "github-actions",
    "npm"
  ],
  "npm": {
    "managerFilePatterns": [
      "/frontend/package.json/",
      "/docs/package.json/"
    ]
  },
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":enableVulnerabilityAlertsWithLabel('security')",
    ":preserveSemverRanges",
    ":rebaseStalePrs",
    "group:recommended",
    ":semanticCommits"
  ],
  "labels": ["renovate"],
  "ignoreUnstable": true,
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "groupName": "Go dependencies"
    },
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "postUpdateOptions": ["gomodTidy"]
    },
    {
      "matchManagers": ["dockerfile"],
      "groupName": "Docker images"
    },
    {
      "matchManagers": ["docker-compose"],
      "groupName": "Docker Compose"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "matchManagers": ["npm"],
      "groupName": "npm dependencies"
    },
    {
      "description": "typescript-eslint supports only typescript <6.1; lift once it supports TS 7",
      "matchManagers": ["npm"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "separateMinorPatch": true,
  "stopUpdatingLabel": "renovate/stop_updating"
}
